# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Administrator password for /openr admin control panel
ADMIN_PASSWORD="LYNXIEE MARKET"

# OpenRouter configuration (optional, can also be configured in /openr dashboard)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Mayzaa AI API endpoint (ChatGPT endpoint)
MAYZAA_API_URL="https://api.mayzaa.my.id/api/ai/chatgpt?text="

# Session secret for secure admin session cookies
SESSION_SECRET="lynxiee_market_ai_super_secret_session_key_2026"

